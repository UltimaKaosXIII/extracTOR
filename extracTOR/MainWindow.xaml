<Window x:Class="extracTOR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:extracTOR"
        mc:Ignorable="d"
        WindowStyle="None"
        Title="ExtracTOR" 
        ResizeMode="NoResize"
        Height="293" 
        Width="730"
        WindowStartupLocation="CenterScreen"
        Background="#333333"
        Foreground="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="b2v"/>
        <Storyboard x:Key="GlowWaveAnimation" RepeatBehavior="Forever">
            <PointAnimation
                Storyboard.TargetName="prgBarGlow"
                Storyboard.TargetProperty="StartPoint"
                From="-2,0" To="1,0"
                Duration="0:0:3"/>
            <PointAnimation
                Storyboard.TargetName="prgBarGlow"
                Storyboard.TargetProperty="EndPoint"
                From="1,0" To="2,0"
                Duration="0:0:4"/>
        </Storyboard>
        <LinearGradientBrush x:Key="ButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Transparent" Offset="1"/>
            <GradientStop Color="Transparent" Offset="0.307"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonDisabled" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#1a1a1a" Offset="1"/>
            <GradientStop Color="#1a1a1a" Offset="0.307"/>
        </LinearGradientBrush>
        <Style TargetType="{x:Type Button}" x:Key="SameBackground2">
            <Setter Property="Background" Value="{StaticResource ButtonDisabled}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="0.6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="{StaticResource ButtonDisabled}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#222222"/>
                    <Setter Property="Foreground" Value="DarkGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Button}" x:Key="SameBackgroundButton">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#222222"/>
                    <Setter Property="Foreground" Value="DarkGray"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="#1a1a1a"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Button}" x:Key="SameBackgroundClose">
            <Setter Property="Foreground" Value="#B2FF0000"/>
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="OpacityMask" Value="#B2FF0000"/>
                    <Setter Property="Foreground" Value="#B2FF0000"/>
                    <Setter Property="Background" Value="Red"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="Background" Value="Red"/>
                    <Setter Property="Foreground" Value="#B2FF0000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section. Window Controls, Window Name, Window Icon -->
        <Grid Background="#1a1a1a" 
              Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" 
                   Source="pack://application:,,,/Resources/Img/Logo_whiteTrans500.png" 
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
            <TextBlock Grid.Column="1" 
                       Text="{Binding Title, RelativeSource={RelativeSource FindAncestor,AncestorType=Window}}" 
                       Foreground="White" 
                       VerticalAlignment="Center"
                       MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
            <TextBlock Grid.Column="2"
                       Grid.ColumnSpan="3"
                       MouseLeftButtonDown="Window_MouseLeftButtonDown"/>
            <Button Grid.Column="5" 
                    HorizontalAlignment="Right" 
                    
                    BorderBrush="Crimson" 
                    Background="Red" 
                    Foreground="#B2FF0000"
                    x:Name="Exit"
                    Click="HandleButtonClick"
                    Width="31"
                    Height="31"
                    Style="{StaticResource SameBackgroundClose}">
                <Image Source="pack://application:,,,/Resources/Img/CloseWindow.png" 
                       
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- Main section -->
        <Border Grid.Row="1" 
                BorderBrush="Black" 
                BorderThickness="1" 
                Margin="5,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="125" Height="125"
                       Source="pack://application:,,,/Resources/Img/Logo_whiteTrans500.png"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Assets Folder:" Grid.Column="0" Grid.Row="0" Foreground="White" Margin="5,5" VerticalAlignment="Center"/>
                    <TextBlock Text="Output Folder:" Grid.Column="0" Grid.Row="1" Foreground="White" Margin="5,5" VerticalAlignment="Center"/>
                    <TextBox x:Name="tbxAssets" Grid.Row="0" Grid.Column="1" Margin="0,5" Background="#1a1a1a" Foreground="White" TextChanged="Assets_TextChanged"/>
                    <TextBox x:Name="tbxOutput" Grid.Row="1" Grid.Column="1" Margin="0,5" Background="#1a1a1a" Foreground="White" TextChanged="Output_TextChanged"/>
                    <Button x:Name="BtnOpenFolderAssets" Content="..." Click="HandleButtonClick" Grid.Row="0" Grid.Column="2" Width="18" Margin="5" Style="{StaticResource SameBackground2}"/>
                    <Button x:Name="BtnOpenFolderOutput" Content="..." Click="HandleButtonClick" Grid.Row="1" Grid.Column="2" Width="18" Margin="5" Style="{StaticResource SameBackground2}"/>
                    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Margin="0,5,5,0">
                        <RadioButton x:Name="rbLive" Checked="RadioButton_Checked" Margin="0,0,0,5"  Content=">Live" Foreground="White" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                        <RadioButton x:Name="rbPTS"  Checked="RadioButton_Checked" Margin="0,0,0,5" Content=">PTS" Foreground="White"   VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                        <RadioButton x:Name="rbBeta" Checked="RadioButton_Checked"  Content=">Beta" Foreground="White" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="chkStats" IsChecked="True" Grid.Row="3" Grid.Column="0" Content="Show Stats" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,5,5"/>
                    <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Vertical" x:Name="SP_Stats" HorizontalAlignment="Right" 
                                Visibility="{Binding IsChecked, ElementName=chkStats, Converter={StaticResource b2v}}" 
                                Margin="0,5,0,0" Grid.RowSpan="3">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="prgExFiles" HorizontalAlignment="Right" Foreground="White" Text="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="prgExSep" HorizontalAlignment="Right" Foreground="White" Text=" / ~" VerticalAlignment="Center" Visibility="Visible"/>
                            <TextBlock x:Name="prgExTotalFiles" HorizontalAlignment="Right" Foreground="White" Text="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="prgExtTotalFilesText" HorizontalAlignment="Right" Margin="0,1,5,1" Foreground="White" Text=" Files" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="prgExPrg" HorizontalAlignment="Right" Foreground="White" Text="{Binding Value, ElementName=prgBarExt, StringFormat={}{0:0.00}}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="prgExPrgComplete" HorizontalAlignment="Right" Margin="0,1,5,1" Foreground="White" Text="% Complete" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="prgTime" HorizontalAlignment="Right" Foreground="White" Text="" VerticalAlignment="Center"/>
                            <TextBlock x:Name="prgTElapsed" HorizontalAlignment="Right" Margin="0,1,5,1" Foreground="White" Text=" Elapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="statMemLabel" HorizontalAlignment="Right" Foreground="White" Text="Peak Memory Usage: " VerticalAlignment="Center"/>
                            <TextBlock x:Name="statMem" HorizontalAlignment="Right" Foreground="White" Text="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="statMemUnit" HorizontalAlignment="Right" Margin="5,1" Foreground="White" Text="GB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="arcsComplete" HorizontalAlignment="Right" Foreground="White" Text="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="arcsCompleteLabel" HorizontalAlignment="Right" Margin="5,1" Foreground="White" Text="Archives Processed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Button x:Name="BtnCheckHash" Click="HandleButtonClick" Grid.Row="0" Grid.Column="0" Content="Check Hash List" Margin="0,5,3,5" Width="117" Style="{StaticResource SameBackground2}"/>
                        <Button x:Name="BtnDLHash" Click="HandleButtonClick" Grid.Row="0" Grid.Column="1" Content="Download Hash List" Margin="0,5,3,5" Width="117" Style="{StaticResource SameBackground2}"/>
                        <Button x:Name="BtnExtract" Click="HandleButtonClick" Grid.Row="1" Grid.Column="0" Content="Extract" Margin="0,5,3,5" Style="{StaticResource SameBackground2}"/>
                        <ProgressBar x:Name="prgBarExt" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="3,5,5,5" Minimum="0" Maximum="100" Background="{StaticResource ButtonBackground}">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush x:Name="prgBarGlow" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF06B025" Offset="0"/>
                                    <GradientStop Color="LawnGreen" Offset="0.5"/>
                                    <GradientStop Color="#FF06B025" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Useful Information -->
        <Border Grid.Row="3" 
                Margin="5,0" 
                BorderBrush="Black" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!-- Column="0" -->
                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Content="Useful Information" Foreground="White"/>
                <Border BorderBrush="Gray" BorderThickness="1" Height="1" Grid.Row="1" Grid.ColumnSpan="3" Margin="20,0"/>
                <Grid Grid.Column="0" Grid.Row="2" Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="GitHub:" Foreground="White" Grid.Row="0" Grid.Column="0" Margin="5,0"/>

                    <Button x:Name="Github" Click="HandleButtonClick" Margin="0,0,5,0" Background="Transparent" Style="{StaticResource SameBackgroundButton}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                        <TextBlock Text="https://github.com/SWTOR-Slicers" Foreground="CornflowerBlue"/>
                    </Button>
                    <TextBlock Text="Discord:" Foreground="White" Grid.Row="1" Grid.Column="0" Margin="5,0"/>
                    <Button x:Name="Discord" Click="HandleButtonClick" Margin="0,0,5,0" Background="Transparent" Style="{StaticResource SameBackgroundButton}" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left">
                        <TextBlock Text="https://discord.gg/XfHFjSN" Foreground="CornflowerBlue"/>
                    </Button>

                    <TextBlock Text="Jedipedia:" Foreground="White" Grid.Row="0" Grid.Column="4" Margin="5,0" HorizontalAlignment="Right"/>
                    <Button x:Name="Jedipedia" Click="HandleButtonClick" Margin="0,0,5,0" Background="Transparent" Style="{StaticResource SameBackgroundButton}" Grid.Row="0" Grid.Column="5" HorizontalAlignment="Left">
                        <TextBlock Text="https://swtor.jedipedia.net" Foreground="CornflowerBlue"/>
                    </Button>

                    <TextBlock Text="TORCommunity:" Foreground="White" Grid.Row="1" Grid.Column="4" Margin="5,0" HorizontalAlignment="Right"/>
                    <Button x:Name="TORCom" Click="HandleButtonClick" Margin="0,0,5,0" Background="Transparent" Style="{StaticResource SameBackgroundButton}" Grid.Row="1" Grid.Column="5" HorizontalAlignment="Left">
                        <TextBlock Text="https://torcommunity.com" Foreground="CornflowerBlue"/>
                    </Button>

                    <TextBlock Text="Blender:" Foreground="White" Grid.Row="2" Grid.Column="4" Margin="5,0" HorizontalAlignment="Right"/>
                    <Button x:Name="Blender" Click="HandleButtonClick" Margin="0,0,5,0" Background="Transparent" Style="{StaticResource SameBackgroundButton}" Grid.Row="2" Grid.Column="5" HorizontalAlignment="Left">
                        <TextBlock Text="https://blender.org" Foreground="CornflowerBlue" Grid.Row="2" Grid.Column="5"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Thanks section -->
        <Grid Grid.Row="4">
            <TextBlock Margin="10,5,0,0" VerticalAlignment="Center" Text="Thanks: Darth Atroxa, C-3PO." HorizontalAlignment="Left"/>
            <TextBlock Margin="0,5,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"  Text="I'll 'finish' it eventually"/>
            <TextBlock Margin="0,5,10,0" VerticalAlignment="Center" Text="[v1.2.1] UltimaKaosXIII - 2026" HorizontalAlignment="Right"/>
        </Grid>

    </Grid>
</Window>